{
  "name": "directus-extension-pii-protect",
  "description": "Anonymisation gouvernée des PII pour agents IA : détection FR + chiffrement réversible, par rôle.",
  "icon": "lock",
  "version": "0.1.0",
  "author": "La Webcapsule <support@webcapsule.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grouzoul/d9-pii-protect.git"
  },
  "license": "MIT",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook",
    "pii",
    "anonymization",
    "privacy",
    "rgpd"
  ],
  "type": "module",
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0 || ^11.0.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --format=esm --platform=node --target=node18 --outfile=dist/index.js",
    "dev": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.0"
  }
}
