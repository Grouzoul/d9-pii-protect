{
  "name": "directus-extension-ecluse",
  "description": "Anonymisation gouvernée des PII pour agents IA : détection FR + chiffrement réversible, par rôle.",
  "icon": "lock",
  "version": "0.1.0",
  "author": "La Webcapsule <support@webcapsule.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grouzoul/ecluse.git"
  },
  "license": "MIT",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook",
    "pii",
    "anonymization",
    "privacy",
    "rgpd"
  ],
  "type": "module",
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^12.0.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^17.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
