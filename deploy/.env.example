# Copier en .env et renseigner. NE JAMAIS committer .env.

# ===== OBLIGATOIRE — clé de chiffrement AES-256 du moteur (custody = la frontière de sécurité) =====
# En prod : secret manager / KMS. Générer : openssl rand -base64 32
PII_PROTECT_KEY=change-me-0123456789abcdef0123456789ab

# ----- Sélection de ce qui est chiffré, PAR TYPE de PII (optionnel) -----
# Par défaut (vide) : tout ce qui est détecté est chiffré (secure-by-default).
# Allow-list : SEULS ces types sont chiffrés.   ex : PII_PROTECT_ENTITIES=NOM_PERSONNE,PRENOM_PERSONNE,NUM_SECURITE_SOCIALE
PII_PROTECT_ENTITIES=
# Deny-list : ces types restent EN CLAIR.        ex : PII_PROTECT_SKIP=VILLE,DATE,CODE_POSTAL
PII_PROTECT_SKIP=

# ----- Sélection de ce qui est traité, PAR CHAMP (optionnel, côté extension) -----
# JSON {collection:[champs]}. Vide = secure-by-default = tous les champs de type 'text'.
# ex : PII_PROTECT_FIELDS={"tickets":["note","description"]}
PII_PROTECT_FIELDS=

# ----- Modèle NER (voir engine/MODELS.md pour changer de langue/modèle) -----
PII_NER_MODEL=Anonym-IA/V2-camembert-ner-pii-french
PII_NER_THRESHOLD=0.4

# ----- Admin d9 -----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ecluse-admin
