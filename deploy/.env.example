# Copy to .env and fill in. NEVER commit .env.

# ===== REQUIRED — the engine's AES-256 encryption key (custody = the security boundary) =====
# In production: secret manager / KMS. Generate: openssl rand -base64 32
PII_PROTECT_KEY=change-me-0123456789abcdef0123456789ab

# ===== REQUIRED — d9 session/signing secrets. Use RANDOM values (openssl rand -base64 32), not these. =====
D9_KEY=change-me-d9-key
D9_SECRET=change-me-d9-secret

# ----- Engine auth (recommended): shared secret between d9 and the engine. Empty = no engine auth. -----
# Set the SAME value here so the engine only accepts calls from the extension. Generate: openssl rand -hex 32
PII_PROTECT_ENGINE_TOKEN=

# ----- Choose what gets encrypted, BY PII TYPE (optional) -----
# Default (empty): everything detected is encrypted (secure-by-default).
# Allow-list: ONLY these types are encrypted.   e.g. PII_PROTECT_ENTITIES=NOM_PERSONNE,PRENOM_PERSONNE,NUM_SECURITE_SOCIALE
PII_PROTECT_ENTITIES=
# Deny-list: these types stay IN CLEAR.          e.g. PII_PROTECT_SKIP=VILLE,DATE,CODE_POSTAL
PII_PROTECT_SKIP=

# ----- Choose what gets processed, BY FIELD (optional, extension side) -----
# JSON {collection:[fields]}. Empty = secure-by-default = all 'text'-type fields.
# e.g. PII_PROTECT_FIELDS={"tickets":["note","description"]}
PII_PROTECT_FIELDS=

# ----- NER model (see engine/MODELS.md to change language/model) -----
PII_NER_MODEL=Anonym-IA/V2-camembert-ner-pii-french
PII_NER_THRESHOLD=0.4
# ONNX Runtime threads: empty = auto. On heterogeneous CPUs (Apple Silicon perf+efficiency cores),
# cap to the performance-core count (e.g. 4) — faster than using every vCPU. Tune per host.
PII_NER_ONNX_THREADS=

# ----- d9 admin -----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-pwd
